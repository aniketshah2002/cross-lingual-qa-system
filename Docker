# Use an official Python image as a base
FROM python:3.9

# Set the working directory inside the container
WORKDIR /code

# Copy the requirements file and install dependencies
COPY ./requirements.txt /code/requirements.txt
RUN pip install --no-cache-dir --upgrade -r /code/requirements.txt

# Copy all your project files into the container
COPY . .

# --- IMPORTANT ---
# Run the pre-processing scripts during the build process.
# This creates the 'knowledge_base' folder on the server so the app can start.
RUN python step2_create_embeddings.py && \
    python step3_build_index.py

# Command to run the Flask application when the container starts
# It exposes the app on port 7860, which is standard for Spaces
CMD ["flask", "run", "--host=0.0.0.0", "--port=7860"]